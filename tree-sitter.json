{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "sh",
      "title": "POSIX sh",
      "scope": "source.sh",
      "path": ".",
      "file-types": ["sh"],
      "injection-regex": "^(sh|shell)$",
      "highlights": "queries/highlights.scm",
      "external-files": [
        "src/arithmetic.h",
        "src/input.h",
        "src/lexical-tokens.h",
        "src/lexical-tokens.json",
        "src/source.h"
      ]
    }
  ],
  "metadata": {
    "version": "0.18.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for POSIX sh.",
    "links": {
      "repository": "https://github.com/konomanoasa/tree-sitter-sh"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false
  }
}
