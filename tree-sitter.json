{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "posix_sh",
      "camelcase": "PosixSh",
      "title": "POSIX sh",
      "scope": "source.sh",
      "path": ".",
      "file-types": ["sh"],
      "injection-regex": "^(sh|shell)$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "A Tree-sitter grammar for POSIX sh.",
    "authors": [
      {
        "name": "konomanoasa"
      }
    ],
    "links": {
      "repository": "https://github.com/konomanoasa/tree-sitter-posix-sh"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
